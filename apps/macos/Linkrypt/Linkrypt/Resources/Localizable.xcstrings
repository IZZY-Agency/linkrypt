{
  "sourceLanguage" : "en",
  "strings" : {
    "Revoke failed — the server refused (403: %@). If your token lacks the shares:revoke scope, mint a new one at /app/tokens." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révocation échouée — le serveur a refusé (403 : %@). Si votre jeton n’a pas la permission shares:revoke, créez-en un nouveau sur /app/tokens." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося відкликати — сервер відмовив (403: %@). Якщо ваш токен не має права shares:revoke, створіть новий на /app/tokens." } }
      }
    },
    "Revoke failed — token is missing scope(s): %@. Mint a token with revoke permission at /app/tokens." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révocation échouée — il manque au jeton la ou les permissions : %@. Créez un jeton avec la permission de révocation sur /app/tokens." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося відкликати — токену бракує прав: %@. Створіть токен із правом відкликання на /app/tokens." } }
      }
    },
    "Revoke failed — token rejected (401). Sign in again." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révocation échouée — jeton rejeté (401). Reconnectez-vous." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося відкликати — токен відхилено (401). Увійдіть знову." } }
      }
    },
    "Revoke failed — server error %lld: %@" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révocation échouée — erreur serveur %lld : %@" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося відкликати — помилка сервера %lld: %@" } }
      }
    },
    "Revoke failed: %@" : {
